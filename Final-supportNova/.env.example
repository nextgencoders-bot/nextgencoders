# Enable Firebase as the durable store (Firestore records and file chunks; Cloud Storage is optional).
SUPPORTNOVA_STORAGE=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional. Leave unset on the free Spark plan; files are chunked into Firestore instead.
# FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Optional Groq GenAI provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SUPPORTNOVA_APP_URL=http://localhost:8000
