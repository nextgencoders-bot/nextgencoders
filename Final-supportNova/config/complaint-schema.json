{
  "schema_version": "1.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["category","subcategory","department","priority","urgency",
               "sentiment","summary","customer_response","resolution_steps",
               "escalation","policy_references","follow_up","secondary_issues",
               "supporting_departments","clarification_questions","injection_indicators",
               "entities","eligibility"],
  "properties": {
    "category": {"type": "string"},
    "subcategory": {"type": "string"},
    "department": {"type": "string"},
    "supporting_departments": {"type": "array", "items": {"type": "string"}},
    "priority": {"type": "string", "enum": ["P1","P2","P3","P4"]},
    "urgency": {"type": "string", "enum": ["Low","Medium","High","Critical"]},
    "sentiment": {"type": "string", "enum": ["Positive","Neutral","Negative","Strongly Negative"]},
    "summary": {"type": "string"},
    "customer_response": {"type": "string"},
    "resolution_steps": {"type": "array", "items": {"type": "string"}},
    "secondary_issues": {"type": "array", "items": {"type": "string"}},
    "clarification_questions": {"type": "array", "items": {"type": "string"}},
    "injection_indicators": {"type": "array", "items": {"type": "string"}},
    "entities": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                  "required": ["type","value","source"],
                  "properties": {"type": {"type": "string", "enum": ["order_id","transaction_date","transaction_id","date"]},
                                 "value": {"type": "string"}, "source": {"type": "string", "enum": ["complaint","customer_context"]}}}},
    "eligibility": {"type": "object", "additionalProperties": false,
                     "required": ["refund","replacement","compensation"],
                     "properties": {"refund": {"type": "string", "enum": ["RequiresValidation","NotApplicable"]},
                                    "replacement": {"type": "string", "enum": ["RequiresValidation","NotApplicable"]},
                                    "compensation": {"type": "string", "enum": ["RequiresValidation","NotApplicable"]}}},
    "escalation": {"type": "object", "additionalProperties": false, "required": ["required","level"],
                   "properties": {"required": {"type": "boolean"}, "level": {"type": "string"}}},
    "policy_references": {"type": "array", "items": {"type": "string"}},
    "follow_up": {"type": "object", "additionalProperties": false, "required": ["required","type"],
                  "properties": {"required": {"type": "boolean"}, "type": {"type": "string"}}}
  }
}
